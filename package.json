{
  "name": "ai-girlfriend",
  "version": "1.0.0",
  "description": "AI 电子女友",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "build:electron": "vite build && electron-packager . \"小希\" --out=release --overwrite --platform=win32 --arch=x64 --electron-version=28.3.3 --ignore=node_modules --ignore=src --ignore=public --ignore=.git --ignore=release --ignore=\"启动.bat\" --ignore=\"启动.sh\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-packager": "^17.1.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  }
}
